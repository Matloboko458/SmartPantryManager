<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFA"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="100dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textColor="#111111"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Add an ingredient to your pantry."
            android:textColor="#777777"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Ingredient Name"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4CAF50"
            android:hint="e.g. Eggs"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:textSize="20sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Quantity"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4CAF50"
            android:hint="e.g. 12"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:textSize="20sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Unit"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtUnit"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4CAF50"
            android:hint="e.g. pieces, kg, liters"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:textSize="20sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Expiry Date"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4CAF50"
            android:hint="DD/MM/YYYY"
            android:inputType="number"
            android:maxLength="10"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:textSize="20sp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:backgroundTint="#4CAF50"
            android:text="Save Ingredient"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>