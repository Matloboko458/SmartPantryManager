<?xml version="1.0" encoding="utf-8"?>

<!--
    Add Ingredient screen.
    Allows the user to enter pantry ingredient information.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Screen description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add an ingredient to your pantry."
            android:textSize="15sp"
            android:layout_marginBottom="28dp" />

        <!-- Ingredient name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient Name"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Eggs"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Quantity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 12"
            android:inputType="number"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Unit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. pieces, kg, litres"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Expiry date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Date"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 30/10/2026"
            android:inputType="date"
            android:padding="14dp"
            android:layout_marginBottom="30dp" />

        <!-- Save ingredient button -->
        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Ingredient"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>